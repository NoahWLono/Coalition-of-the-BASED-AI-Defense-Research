{
  "schema_version": 1,
  "id": "07-gcs-transient",
  "title": "Short heartbeat dropout does not trigger LAND",
  "starter": false,
  "baseline": false,
  "parameters": {},
  "preconditions": {
    "mode": 4,
    "armed": true,
    "min_altitude_m": 10.5,
    "max_altitude_m": 13.5,
    "max_abs_vz_cm_s": 30,
    "stable_for_s": 3,
    "min_battery_mv": 11500,
    "min_gps_fix": 3
  },
  "events": [
    {
      "id": "brief",
      "at_s": 5,
      "kind": "heartbeat",
      "enabled": false
    },
    {
      "id": "restore",
      "at_s": 6.2,
      "kind": "heartbeat",
      "enabled": true
    },
    {
      "id": "land",
      "at_s": 18,
      "kind": "mode",
      "mode": "LAND"
    }
  ],
  "max_compound_skew_s": 0.25,
  "assertions": [
    {
      "type": "heartbeat_gap",
      "after": "brief",
      "duration_s": 1,
      "fault_evidence": true
    },
    {
      "type": "heartbeat_resumed",
      "after": "restore",
      "within_s": 1
    },
    {
      "type": "hold_mode",
      "after": "brief",
      "start_s": 0,
      "duration_s": 12,
      "allowed": [
        4
      ]
    },
    {
      "type": "disarmed",
      "after": "land",
      "within_s": 45
    }
  ],
  "duration_s": 65,
  "cleanup": "Terminate and reap fresh simulator; never reuse eeprom; retain raw evidence",
  "rationale": "1.2s planned outage is below3s timeout even with heartbeat phase. Require observed silence and GUIDED through17s."
}
