{
  "schema_version": 1,
  "id": "05-rc-recovery",
  "title": "RC recovery remains LAND",
  "starter": false,
  "baseline": false,
  "parameters": {},
  "preconditions": {
    "mode": 4,
    "armed": true,
    "min_altitude_m": 10.5,
    "max_altitude_m": 13.5,
    "max_abs_vz_cm_s": 30,
    "stable_for_s": 3,
    "min_battery_mv": 11500,
    "min_gps_fix": 3
  },
  "events": [
    {
      "id": "rc",
      "at_s": 5,
      "kind": "parameter",
      "name": "SIM_RC_FAIL",
      "value": 1
    },
    {
      "id": "restore",
      "at_s": 12,
      "kind": "parameter",
      "name": "SIM_RC_FAIL",
      "value": 0
    }
  ],
  "max_compound_skew_s": 0.25,
  "assertions": [
    {
      "type": "text",
      "after": "rc",
      "within_s": 6,
      "contains": "Radio Failsafe",
      "fault_evidence": true
    },
    {
      "type": "mode",
      "after": "rc",
      "within_s": 6,
      "allowed": [
        9
      ]
    },
    {
      "type": "text",
      "after": "restore",
      "within_s": 5,
      "contains": "Radio Failsafe Cleared",
      "fault_evidence": true
    },
    {
      "type": "hold_mode",
      "after": "restore",
      "start_s": 1,
      "duration_s": 10,
      "allowed": [
        9
      ]
    },
    {
      "type": "disarmed",
      "after": "rc",
      "within_s": 50
    }
  ],
  "duration_s": 62,
  "cleanup": "Terminate and reap fresh simulator; never reuse eeprom; retain raw evidence",
  "rationale": "Restored pulses clear radio failsafe but mode stays LAND. No pilot mode change is injected."
}
